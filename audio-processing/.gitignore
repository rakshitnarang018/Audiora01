# # # Temporary and Media Files
# Ignoring the 'temp' directory and the 'sample_songs' directory.
# Large media files should not be stored in a Git repository as they bloat its size.
# It's better to store them elsewhere (like cloud storage) and provide a download script or instructions.
/temp/
/sample_songs/

# Also ignore common audio and data file extensions that might be generated or used
*.mp3
*.wav
*.flac
*.m4a
*.ogg
*.aiff
*.csv
*.dat

# # # IDE and Editor directories
# For VS Code, which you appear to be using
.vscode/
# For other common IDEs
.idea/

# # # Environment variables
# Files for storing secrets and local configuration
.env
*.env

